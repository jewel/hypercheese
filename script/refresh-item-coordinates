#!/usr/bin/ruby

# Re-read GPS coordinates from the source files for every geotagged item.
# Only updates latitude/longitude; locations and places are left alone.

APP_PATH = File.expand_path('../../config/application',  __FILE__)
require File.expand_path('../../config/boot',  __FILE__)
require APP_PATH
Rails.application.require_environment!

job = GeolocateJob.new
updated = failed = 0

Item.where(deleted: false).where.not(latitude: nil).find_each do |item|
  coords = job.extract_coordinates item
  next unless coords
  item.update_columns latitude: coords[:latitude].to_f, longitude: coords[:longitude].to_f
  updated += 1
  puts "#{updated} updated" if updated % 1000 == 0
rescue => e
  failed += 1
  warn "#{item.id}: #{e.message}"
end

puts "Updated #{updated}, failed #{failed}"
